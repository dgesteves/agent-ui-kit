{
  "name": "@dgesteves/agent-ui-kit",
  "version": "0.4.1",
  "description": "Accessible React components for agent-run UX: tool timelines, human-in-the-loop approvals, diff review and run telemetry. For AI SDK 6 & 7 and AG-UI.",
  "license": "MIT",
  "author": "Diogo Esteves (https://diogo-studio.com)",
  "homepage": "https://agent-ui-kit-demo.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dgesteves/agent-ui-kit.git",
    "directory": "packages/agent-ui-kit"
  },
  "bugs": "https://github.com/dgesteves/agent-ui-kit/issues",
  "keywords": [
    "react",
    "ai",
    "ai-sdk",
    "agents",
    "ag-ui",
    "agent-ui",
    "human-in-the-loop",
    "tool-calling",
    "diff",
    "tailwindcss",
    "shadcn",
    "accessibility"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./ag-ui": {
      "types": "./dist/ag-ui.d.ts",
      "default": "./dist/ag-ui.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles.layered.css": "./dist/styles.layered.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./theme.css": "./dist/theme.css",
    "./theme.auto.css": "./dist/theme.auto.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && node scripts/build-css.mjs && node scripts/check-directives.mjs && node scripts/check-dist.mjs",
    "dev": "tsdown --watch --no-clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:package": "publint && attw --pack . --profile esm-only --exclude-entrypoints ./styles.css ./styles.layered.css ./tailwind.css ./theme.css ./theme.auto.css",
    "prepack": "node scripts/npm-readme.mjs prepack",
    "postpack": "node scripts/npm-readme.mjs postpack"
  },
  "peerDependencies": {
    "ai": "^6.0.0 || ^7.0.102",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.20",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remend": "^1.4.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@ag-ui/client": "^1.0.2",
    "@ag-ui/core": "^1.0.2",
    "@arethetypeswrong/cli": "^0.18.5",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ai": "^7.0.128",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "postcss-selector-parser": "^7.1.6",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rxjs": "7.8.1",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "vitest-axe": "^0.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
